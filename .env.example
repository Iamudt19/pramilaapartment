# Database connection string (Supabase / PostgreSQL)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/pramila_apartments?schema=public"

# JWT Authentication Secret (32+ random characters)
JWT_SECRET="generate-a-strong-32-character-secret-key"

# Application Environment & Port
NODE_ENV="production"
PORT=3000

# Management Defaults
NEXT_PUBLIC_APP_NAME="Pramila Apartments"
MANAGEMENT_EMAIL="office.pramilaapartment@gmail.com"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Supabase Storage & Database Configuration (100% Free - No Credit Card Needed)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Transactional Email (Resend / SendGrid / SMTP)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="YOUR_SMTP_KEY"
SMTP_FROM="Pramila Apartments <office.pramilaapartment@gmail.com>"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
