# Database connection string (PostgreSQL for Production, SQLite for Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pramila_apartments?schema=public"

# JWT Authentication Secret
JWT_SECRET="generate-a-strong-32-character-secret-key"

# Application Environment & Port
NODE_ENV="production"
PORT=3000

# Management Defaults
NEXT_PUBLIC_APP_NAME="Pramila Apartments"
MANAGEMENT_EMAIL="office.pramilaapartment@gmail.com"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Storage Configuration (Private S3 Compatible)
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
STORAGE_BUCKET="pramila-apartments-secure-docs"
STORAGE_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_S3_SECRET_KEY"

# Transactional Email (Resend / SendGrid / SMTP)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="YOUR_SMTP_KEY"
SMTP_FROM="Pramila Apartments <office.pramilaapartment@gmail.com>"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
